# docker-compose용 환경변수 템플릿. 복사해서 .env로 저장한다 (.env 는 커밋 금지)
#   cp .env.example .env
#
# 아래 값은 로컬 개발 전용 기본값이라 그대로 써도 된다.
# 값을 바꾸면 src/main/resources/application-local.yaml 의
# username / password 도 똑같이 맞춰야 한다. 안 그러면 Access denied 로 기동에 실패한다.

DB_USERNAME=petnow
DB_PASSWORD=petnow1234
DB_ROOT_PASSWORD=root1234
