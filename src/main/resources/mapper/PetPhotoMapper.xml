<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.petnow.mapper.PetPhotoMapper">

    <insert id="insertPhoto"
            parameterType="com.example.petnow.entity.PetPhoto"
            useGeneratedKeys="true"
            keyProperty="petPhotoId">

        INSERT INTO pet_photos
        (
            pet_id,
            file_url,
            sort_order
        )
        VALUES
        (
            #{petId},
            #{fileUrl},
            #{sortOrder}
        )

    </insert>

    <select id="findByPetId"
            parameterType="long"
            resultType="com.example.petnow.entity.PetPhoto">

        SELECT
            pet_photo_id,
            pet_id,
            file_url,
            sort_order,
            created_at,
            updated_at
        FROM pet_photos
        WHERE pet_id = #{petId}
        ORDER BY sort_order

    </select>

    <delete id="deleteByPetId">

        DELETE
        FROM pet_photos
        WHERE pet_id = #{petId}

    </delete>

</mapper>
