<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.petnow.mapper.ReviewMapper">

    <insert id="insertReview"
            parameterType="com.example.petnow.entity.Review"
            useGeneratedKeys="true"
            keyProperty="reviewId">

        INSERT INTO reviews ( reservation_id, rating, content )
        VALUES ( #{reservationId}, #{rating}, #{content} )

    </insert>

</mapper>
