<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.petnow.mapper.ReservationMapper">

    <resultMap id="ReservationDetailMap" type="com.example.petnow.entity.Reservation">
        <id property="id" column="id"/>
        <result property="userId" column="guest_user_id"/>
        <result property="placeId" column="place_id"/>
        <result property="reservationType" column="reservation_type"/>
        <result property="checkIn" column="check_in_at"/>
        <result property="checkOut" column="check_out_at"/>
        <result property="status" column="status"/>
        <result property="memo" column="request_message"/>
        <result property="totalPrice" column="total_price"/>
        <result property="respondedAt" column="responded_at"/>
        <result property="canceledAt" column="canceled_at"/>
        <result property="cancelReason" column="cancel_reason"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reservations
        (guest_user_id, place_id, reservation_type, check_in_at, check_out_at, status, request_message, total_price)
        VALUES
        (#{userId}, #{placeId}, #{reservationType}, #{checkIn}, #{checkOut}, #{status}, #{memo}, #{totalPrice})
    </insert>

    <insert id="saveReservationPets">
        INSERT INTO reservation_pets (reservation_id, pet_id)
        VALUES
        <foreach collection="petIds" item="petId" separator=",">
            (#{reservationId}, #{petId})
        </foreach>
    </insert>

</mapper>