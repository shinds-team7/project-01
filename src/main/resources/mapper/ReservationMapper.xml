<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.petnow.mapper.ReservationMapper">

    <resultMap id="ReservationDetailMap" type="com.example.petnow.entity.Reservation">
        <id property="id" column="reservation_id"/>
        <result property="userId" column="user_id"/>
        <result property="placeId" column="place_id"/>
        <result property="status" column="status"/>
        <result property="checkIn" column="check_in"/>
        <result property="checkOut" column="check_out"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reservations (user_id, place_id, check_in, check_out, status, memo)
        VALUES (#{userId}, #{placeId}, #{checkIn}, #{checkOut}, #{status}, #{memo})
    </insert>

    <insert id="saveReservationPets">
        INSERT INTO reservation_pets (reservation_id, pet_id)
        VALUES
        <foreach collection="petIds" item="petId" separator=",">
            (#{reservationId}, #{petId})
        </foreach>
    </insert>

</mapper>