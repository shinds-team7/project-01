<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.petnow.mapper.PetMapper">
    <insert id="insertPet">
        INSERT INTO pets
        (
            user_id,
            name,
            birth_year,
            gender,
            weight,
            neutered,
            note,
            size_code
        )
        VALUES
            (
                #{userId},
                #{name},
                #{birthYear},
                #{gender},
                #{weight},
                #{neutered},
                #{note},
                #{sizeCode}
            )
    </insert>

    <select id="petList"
            parameterType="long"
            resultType="com.example.petnow.dto.response.PetListResponse">

        SELECT
            id,
            name,
            size_code,
            weight
        FROM pets
        WHERE user_id = #{userId}
        ORDER BY created_at DESC

    </select>
</mapper>