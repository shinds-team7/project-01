spring:
  datasource:
    driver-class-name: org.mariadb.jdbc.Driver
    url: jdbc:mariadb://localhost:3306/petnow
    username: testuser
    password: test1234
    hikari:
      maximum-pool-size: 10
      minimum-idle: 5
  flyway:
    # 기존 petnow_schema.sql로 만든 로컬 DB는 현재 마이그레이션 버전으로 등록한다.
    baseline-on-migrate: true
    baseline-version: "4"

logging:
  level:
    org.springframework.web: debug
