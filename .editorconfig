# 에디터가 저장할 때 자동으로 맞춰 주는 최소 규칙 (#170).
# IntelliJ · VS Code · Eclipse 가 별도 플러그인 없이 읽는다.
#
# docs/CONVENTIONS.md §4 를 기계가 강제하는 부분만 옮겼다.
# 여기 없는 규칙(이름 짓기, 주석 위치 등)은 문서를 본다.
#
# 이 파일은 "앞으로 저장되는 코드"에만 적용된다. 이미 탭으로 들어와 있는 파일을
# 일괄 변환하는 일은 별도로 다룬다. CONVENTIONS §4 가 "파일마다 개별로 고치지 말 것"
# 이라고 못 박은 이유가 진행 중인 브랜치와의 충돌이다.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.md]
# 마크다운은 줄 끝 공백 두 개가 줄바꿈이라 지우면 문서가 깨진다.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Gradle 래퍼는 배포된 파일 그대로 둔다.
[gradlew*]
insert_final_newline = false
trim_trailing_whitespace = false
